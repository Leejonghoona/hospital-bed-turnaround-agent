@prefix ta:   <urn:turnaround:> .
@prefix sh:   <http://www.w3.org/ns/shacl#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .
@prefix rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

# SHACL 제약 (최소판). 각 형상의 rdfs:comment가 위반 코드다. 하위 개념은 rdfs:subClassOf 사슬로 따라간다.

ta:shapes sh:declare [ sh:prefix "ta" ; sh:namespace "urn:turnaround:"^^xsd:anyURI ] .

# 배정된 병상은 알려진 병상이어야 한다
ta:KnownBedShape a sh:NodeShape ;
    rdfs:comment "unknown_bed" ;
    sh:targetSubjectsOf ta:assignedTo ;
    sh:property [ sh:path ta:assignedTo ; sh:class ta:Bed ; sh:message "없는 병상에 배정" ] .

# 접촉·비말주의(공기주의 아님)는 1인실(음압격리실 포함) 또는 같은 병원체 코호트실 (LP-17)
ta:IsolationRoomShape a sh:NodeShape ;
    rdfs:comment "isolation_room" ;
    sh:targetClass ta:IsolationPatient ;
    sh:sparql [ sh:message "접촉·비말주의는 1인실 또는 같은 병원체 코호트실" ; sh:prefixes ta:shapes ;
        sh:select """SELECT $this WHERE { $this ta:assignedTo/ta:inRoom ?room .
                     FILTER NOT EXISTS { $this a/rdfs:subClassOf* ta:AirborneIsolationPatient }
                     FILTER NOT EXISTS { ?room a/rdfs:subClassOf* ta:SingleRoom }
                     FILTER NOT EXISTS { ?room ta:cohortKey ?k . $this ta:organism ?k } }""" ] .

# 활동성 폐결핵은 방을 함께 쓰지 않는다
ta:TBSharedRoomShape a sh:NodeShape ;
    rdfs:comment "tb_shared_room" ;
    sh:targetClass ta:Patient ;
    sh:sparql [ sh:message "활동성 폐결핵 환자 방 공유" ; sh:prefixes ta:shapes ;
        sh:select """SELECT DISTINCT $this WHERE { $this ta:organism "MTB" ; ta:assignedTo/ta:inRoom ?room .
                     ?o ta:assignedTo/ta:inRoom ?room . FILTER (?o != $this) }""" ] .

# 코호트실에는 그 병원체 격리 환자만
ta:NonCohortShape a sh:NodeShape ;
    rdfs:comment "non_cohort_in_cohort_room" ;
    sh:targetClass ta:Patient ;
    sh:sparql [ sh:message "코호트실에 다른 병원체 또는 비격리 환자" ; sh:prefixes ta:shapes ;
        sh:select """SELECT $this WHERE { $this ta:assignedTo/ta:inRoom ?room . ?room ta:cohortKey ?k .
                     FILTER NOT EXISTS { $this ta:organism ?k ; a/rdfs:subClassOf* ta:IsolationPatient } }""" ] .

# 코호트실에 면역저하·개방창상 환자 금지
ta:ProtectiveInCohortShape a sh:NodeShape ;
    rdfs:comment "protective_in_cohort" ;
    sh:targetClass ta:Patient ;
    sh:sparql [ sh:message "면역저하·개방창상 환자가 코호트실" ; sh:prefixes ta:shapes ;
        sh:select """SELECT DISTINCT $this WHERE { $this ta:assignedTo/ta:inRoom ?room . ?room ta:cohortKey ?k .
                     { $this ta:immunocompromised true } UNION { $this ta:openWound true } }""" ] .

# 선제 격리는 코호트실 금지 (1인실만)
ta:PreemptiveInCohortShape a sh:NodeShape ;
    rdfs:comment "preemptive_in_cohort" ;
    sh:targetClass ta:Patient ;
    sh:sparql [ sh:message "선제 격리 환자가 코호트실" ; sh:prefixes ta:shapes ;
        sh:select """SELECT $this WHERE { $this ta:precautionStatus "preemptive" ;
                     ta:assignedTo/ta:inRoom ?room . ?room ta:cohortKey ?k . }""" ] .

# 공기감염 격리 필요 환자는 음압격리실만 (LP-01)
ta:AirborneRoomShape a sh:NodeShape ;
    rdfs:comment "airborne_needs_negative_pressure" ;
    sh:targetClass ta:AirborneIsolationPatient ;
    sh:property [ sh:path ( ta:assignedTo ta:inRoom ) ; sh:class ta:NegativePressureRoom ;
                  sh:message "공기감염 격리 필요 환자는 음압격리실만" ] .

# 다인실 배정 환자는 성별 값이 있어야 한다 (sh:minCount 없이는 누락 환자가 통과하는 구멍)
ta:GenderPresentShape a sh:NodeShape ;
    rdfs:comment "gender_missing" ;
    sh:targetClass ta:Patient ;
    sh:sparql [ sh:message "성별 입력 누락 환자를 다인실에 배정" ; sh:prefixes ta:shapes ;
        sh:select """SELECT $this WHERE { $this ta:assignedTo/ta:inRoom ?room . ?room a ta:MultiRoom .
                     FILTER NOT EXISTS { $this ta:gender ?g } }""" ] .

# 다인실은 성별 일치
ta:GenderRoomShape a sh:NodeShape ;
    rdfs:comment "gender_room" ;
    sh:targetClass ta:Patient ;
    sh:sparql [ sh:message "성별 병실 불일치" ; sh:prefixes ta:shapes ;
        sh:select """SELECT $this WHERE { $this ta:assignedTo/ta:inRoom ?room ; ta:gender ?g .
                     ?room a ta:MultiRoom ; ta:gender ?rg . FILTER (?g != ?rg) }""" ] .

# 동명이인 같은 병실 금지 (SHACL-SPARQL, 두 환자 비교). 병실 안의 겹치는 이름마다 위반 하나
ta:SameNameShape a sh:NodeShape ;
    rdfs:comment "same_name_room" ;
    sh:targetClass ta:Room ;
    sh:sparql [ sh:message "동명이인이 같은 병실" ; sh:prefixes ta:shapes ;
        sh:select """SELECT DISTINCT $this ?value WHERE { ?a ta:assignedTo/ta:inRoom $this ; ta:name ?value .
                     ?b ta:assignedTo/ta:inRoom $this ; ta:name ?value . FILTER (?a != ?b) }""" ] .

# 격리 퇴실 병상은 종말소독
ta:TerminalCleaningShape a sh:NodeShape ;
    rdfs:comment "terminal_cleaning_missing" ;
    sh:targetClass ta:BedTurnover ;
    sh:sparql [ sh:message "격리 퇴실인데 종말소독이 아님" ; sh:prefixes ta:shapes ;
        sh:select """SELECT $this WHERE { $this ta:previousIsolation true .
                     FILTER NOT EXISTS { $this ta:cleaningType "terminal" } }""" ] .

# 종말소독 완료 전 매칭 확정 금지
ta:CommitBeforeDisinfectionShape a sh:NodeShape ;
    rdfs:comment "commit_before_disinfection" ;
    sh:targetClass ta:BedTurnover ;
    sh:sparql [ sh:message "종말소독 완료 전 매칭 확정" ; sh:prefixes ta:shapes ;
        sh:select """SELECT $this WHERE { $this ta:previousIsolation true ; ta:cleaningType "terminal" ;
                     ta:committedAt ?c . OPTIONAL { $this ta:cleaningDoneAt ?d }
                     FILTER (!BOUND(?d) || ?c < ?d) }""" ] .

# 종말소독 완료 전 빈 병상 전환 금지
ta:VacantBeforeDisinfectionShape a sh:NodeShape ;
    rdfs:comment "vacant_before_disinfection" ;
    sh:targetClass ta:BedTurnover ;
    sh:sparql [ sh:message "종말소독 완료 전 빈 병상 전환" ; sh:prefixes ta:shapes ;
        sh:select """SELECT $this WHERE { $this ta:previousIsolation true ; ta:cleaningType "terminal" ;
                     ta:vacantAt ?v . OPTIONAL { $this ta:cleaningDoneAt ?d }
                     FILTER (!BOUND(?d) || ?v < ?d) }""" ] .

# 비말·공기주의 퇴실 병실은 환기 대기 뒤 청소 시작 (LP-20)
ta:AerosolWaitShape a sh:NodeShape ;
    rdfs:comment "cleaning_before_aerosol_wait" ;
    sh:targetClass ta:BedTurnover ;
    sh:sparql [ sh:message "환기 대기 전 청소 시작" ; sh:prefixes ta:shapes ;
        sh:select """SELECT $this WHERE { $this ta:previousIsolation true ; ta:cleaningType "terminal" ;
                     ta:aerosolReadyAt ?r ; ta:cleaningStartedAt ?s . FILTER (?s < ?r) }""" ] .

# C. difficile 퇴실은 아포 대응 소독 (LP-20)
ta:SporicidalShape a sh:NodeShape ;
    rdfs:comment "sporicidal_missing" ;
    sh:targetClass ta:BedTurnover ;
    sh:sparql [ sh:message "C. difficile 퇴실 아포 소독 누락" ; sh:prefixes ta:shapes ;
        sh:select """SELECT $this WHERE { $this ta:previousIsolation true ; ta:cleaningType "terminal" ;
                     ta:previousOrganism "CDIFF" . FILTER NOT EXISTS { $this ta:sporicidalDone true } }""" ] .

# 원인균은 알려진 정규 코드여야 한다 (2026-11-12 검수 A1). 위 형상들이 "MTB"·"CDIFF" 글자에 기대므로,
# 정규화되지 않은 표기(예: "TB", SNOMED 숫자 코드)가 들어오면 규칙이 조용히 빠지지 않게 위반으로 올린다.
ta:KnownOrganismShape a sh:NodeShape ;
    rdfs:comment "unknown_organism" ;
    sh:targetSubjectsOf ta:organism ;
    sh:property [ sh:path ta:organism ;
        sh:in ( "MTB" "MEASLES" "VARICELLA" "INFLUENZA" "PERTUSSIS" "ADENOVIRUS" "MRSA" "VRE" "CRE" "CDIFF" ) ;
        sh:message "정규화되지 않은 원인균 코드" ] .
